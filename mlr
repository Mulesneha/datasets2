#Multiple Linear Regression
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error,r2_score

df=pd.read_csv("C:/Users/admin/Downloads/Salary_Data.csv")
df=df.dropna()
#split dataset
X_train,X_test,y_train,y_test=train_test_split(df[['Age', 'Years of Experience']],df['Salary'],test_size=0.3)
#create model
reg=LinearRegression()
#train model
reg.fit(X_train,y_train)
#model score
print(reg.score(X_train,y_train))
#prediction
y_pred=reg.predict(X_test)
#plt
plt.scatter(df['Years of Experience'],df['Salary'],color='b')
plt.scatter(df['Age'],df['Salary'],color='y')
plt.plot(X_test['Years of Experience'],y_pred)

plt.title("Multiple linear Regression")
plt.show()
